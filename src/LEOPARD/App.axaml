<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LEOPARD.App"
             xmlns:local="using:LEOPARD"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="#0B0E13" />
            <Setter Property="Foreground" Value="#F2F4F7" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F2F4F7" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F2F4F7" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#929BA8" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="BorderBrush" Value="#242B36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="#151A22" />
            <Setter Property="BorderBrush" Value="#242B36" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#C7F36B" />
            <Setter Property="Foreground" Value="#12160C" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#222A35" />
            <Setter Property="Foreground" Value="#E9EDF3" />
            <Setter Property="BorderBrush" Value="#313B49" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB3BF" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#1C252F" />
            <Setter Property="Foreground" Value="#C7F36B" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#10151C" />
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#303946" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#10151C" />
            <Setter Property="Foreground" Value="#F2F4F7" />
            <Setter Property="BorderBrush" Value="#303946" />
        </Style>
    </Application.Styles>
</Application>
