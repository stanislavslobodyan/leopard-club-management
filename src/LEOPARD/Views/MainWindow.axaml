<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LEOPARD.ViewModels"
        xmlns:models="using:LEOPARD.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="900"
        x:Class="LEOPARD.Views.MainWindow" x:DataType="vm:MainViewModel"
        Title="LEOPARD — Адміністрування клубу" Width="1360" Height="900" MinWidth="360" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowDecorations="None" CanResize="True"
        Background="#0B0E13" Foreground="#F2F4F7">
    <Grid RowDefinitions="*,Auto">
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SidebarColumnWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" IsVisible="{Binding IsWide}" Background="#10141B" BorderBrush="#242B36" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
                <StackPanel Grid.Row="0" Margin="20,22,18,18" Orientation="Horizontal" Spacing="10">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#C7F36B"><TextBlock Text="L" Foreground="#12160C" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center" Spacing="0"><TextBlock Text="LEOPARD" FontSize="15" FontWeight="Black" LetterSpacing="0.8"/><TextBlock Text="КЕРУВАННЯ КЛУБОМ" FontSize="10" Foreground="#788497" LetterSpacing="0.65"/></StackPanel>
                </StackPanel>
                <Border Grid.Row="1" Margin="14,0,14,18" Padding="10,8" Background="#11161E" BorderBrush="#242B36" BorderThickness="1" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="◉" Foreground="#A8B5C8" FontSize="14"/><TextBlock Text="{Binding CurrentClubText}" FontSize="13" Foreground="#C9D1DD"/><TextBlock Text="⌄" Foreground="#8290A4" FontSize="13"/></StackPanel>
                </Border>
                <StackPanel Grid.Row="2" Margin="12,0" Spacing="4">
                    <TextBlock Text="РОБОЧИЙ ПРОСТІР" Classes="eyebrow" Margin="9,0,0,7"/>
                    <Button Classes="nav" Classes.active="{Binding IsDashboard}" Command="{Binding ShowDashboardCommand}" Content="▦   Огляд"/>
                    <Button Classes="nav" Classes.active="{Binding IsSessions}" Command="{Binding ShowSessionsCommand}" Content="◉   Активні сеанси"/>
                    <Button Classes="nav" Classes.active="{Binding IsBookings}" Command="{Binding ShowBookingsCommand}" Content="▣   Бронювання"/>
                    <Button Classes="nav" Classes.active="{Binding IsComputers}" Command="{Binding ShowComputersCommand}" Content="▤   Комп’ютери"/>
                    <Button Classes="nav" Classes.active="{Binding IsClients}" Command="{Binding ShowClientsCommand}" Content="♙   Клієнти"/>
                    <Button Classes="nav" Classes.active="{Binding IsTariffs}" Command="{Binding ShowTariffsCommand}" Content="◇   Тарифи"/>
                    <Button Classes="nav" Classes.active="{Binding IsHistory}" Command="{Binding ShowHistoryCommand}" Content="◷   Історія"/>
                </StackPanel>
                <Border Grid.Row="3" Margin="12,12,12,7" Padding="11" Classes="panel"><StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="#C7F36B" VerticalAlignment="Center"/><TextBlock Text="{Binding AgentSummaryText}" FontSize="13" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding AgentDetailText}" FontSize="12" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Button Grid.Row="4" Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding ShowSettingsCommand}" Margin="12,0" Content="⚙   Налаштування"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="62,*,Auto">
            <Border Grid.Row="0" Background="#10141B" BorderBrush="#242B36" BorderThickness="0,0,0,1" PointerPressed="TitleBar_PointerPressed">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,0,12,0">
                    <TextBox Grid.Column="0" Width="310" VerticalAlignment="Center" PlaceholderText="⌕   Пошук у клубі..." Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" IsVisible="{Binding IsWide}" KeyDown="SearchBox_KeyDown"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCompact}"><Border Width="30" Height="30" CornerRadius="8" Background="#C7F36B"><TextBlock Text="L" Foreground="#12160C" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="LEOPARD" FontSize="14" FontWeight="Black" LetterSpacing="0.5"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDateText}" Classes="muted" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding IsWide}"/>
                        <TextBlock Text="{Binding CurrentTimeText}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Classes="window-control" Command="{Binding ToggleNotificationsCommand}" Content="♧" ToolTip.Tip="Сповіщення"/>
                        <Border Width="27" Height="27" CornerRadius="14" Background="#202834" IsVisible="{Binding IsWide}"><TextBlock Text="AD" FontSize="12" FontWeight="Bold" Foreground="#D6DCE6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Spacing="0" VerticalAlignment="Center" IsVisible="{Binding IsWide}"><TextBlock Text="Адміністратор" FontSize="13"/><TextBlock Text="Робоча станція" FontSize="11" Classes="muted"/></StackPanel>
                        <Button Classes="window-control" Content="AD" Command="{Binding ShowSettingsCommand}" IsVisible="{Binding IsCompact}" ToolTip.Tip="Інші розділи"/>
                        <Button Classes="window-control" Content="—" Click="MinimizeWindow_Click" ToolTip.Tip="Згорнути"/><Button Classes="window-control" Content="□" Click="ToggleMaximizeWindow_Click" ToolTip.Tip="Розгорнути"/><Button Classes="window-control" Content="×" Click="CloseWindow_Click" ToolTip.Tip="Закрити"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="{Binding ContentMargin}" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4"><TextBlock Text="{Binding PageTitle}" Classes="page-title"/><TextBlock Text="{Binding PageSubtitle}" Classes="page-subtitle"/></StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding IsWide}">
                            <Button Classes="primary" Command="{Binding StartSessionCommand}" Content="＋  Новий сеанс" IsVisible="{Binding IsDashboard}"/>
                            <Button Classes="primary" Command="{Binding StartSessionCommand}" Content="＋  Новий сеанс" IsVisible="{Binding IsSessions}"/>
                            <Button Classes="primary" Command="{Binding ShowNewReservationDialogCommand}" Content="＋  Нове бронювання" IsVisible="{Binding IsBookings}"/>
                            <Button Classes="primary" Command="{Binding ShowNewComputerDialogCommand}" Content="＋  Додати ПК" IsVisible="{Binding IsComputers}"/>
                            <Button Classes="primary" Command="{Binding ShowNewClientDialogCommand}" Content="＋  Додати клієнта" IsVisible="{Binding IsClients}"/>
                            <Button Classes="primary" Command="{Binding ShowNewTariffDialogCommand}" Content="＋  Додати тариф" IsVisible="{Binding IsTariffs}"/>
                        </Grid>
                    </Grid>

                    <StackPanel IsVisible="{Binding IsDashboardWide}" Spacing="14">
                        <UniformGrid Columns="4">
                            <Border Classes="metric" Margin="0,0,8,0" Padding="12" Height="92"><StackPanel Spacing="3"><TextBlock Text="АКТИВНІ ПК" Classes="eyebrow"/><TextBlock Text="{Binding ActiveComputerRatio}" FontSize="24" FontWeight="Bold" Foreground="#C7F36B"/><TextBlock Text="{Binding OccupancyText}" FontSize="11" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Margin="0,0,8,0" Padding="12" Height="92"><StackPanel Spacing="3"><TextBlock Text="ВІЛЬНІ ПК" Classes="eyebrow"/><TextBlock Text="{Binding FreeCount}" FontSize="24" FontWeight="Bold"/><TextBlock Text="Готові до нового сеансу" FontSize="11" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Margin="0,0,8,0" Padding="12" Height="92"><StackPanel Spacing="3"><TextBlock Text="ЗАБРОНЬОВАНІ ПК" Classes="eyebrow"/><TextBlock Text="{Binding ReservedCount}" FontSize="24" FontWeight="Bold" Foreground="#72B8FF"/><TextBlock Text="Мають майбутній слот" FontSize="11" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Padding="12" Height="92"><StackPanel Spacing="3"><TextBlock Text="НАРАХОВАНО СЬОГОДНІ" Classes="eyebrow"/><TextBlock Text="{Binding TodayAccruedAmount}" FontSize="22" FontWeight="Bold" Foreground="#C7F36B"/><TextBlock Text="{Binding ActiveAccruedAmount, StringFormat='{}{0} за активні сеанси'}" FontSize="11" Classes="muted"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="3"><TextBlock Text="Активні сеанси" Classes="section-title"/><TextBlock Text="Поточний стан клубу та залишок часу." Classes="page-subtitle"/></StackPanel><Button Grid.Column="1" Classes="secondary" Command="{Binding ShowSessionsCommand}" Content="Усі сеанси  →" VerticalAlignment="Center"/></Grid>
                        <Border Classes="panel" Padding="0"><StackPanel>
                            <Border Classes="table-header" Padding="10,8"><Grid ColumnDefinitions="60,1.2*,0.9*,0.8*,0.65*,0.7*,1*,0.8*"><TextBlock Text="ПК" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="КЛІЄНТ" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="ГРА" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="ТАРИФ" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="ПОЧАТОК" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="ТРИВАЛІСТЬ" Classes="eyebrow"/><TextBlock Grid.Column="6" Text="ЗАЛИШИЛОСЬ" Classes="eyebrow"/><TextBlock Grid.Column="7" Text="СТАТУС" Classes="eyebrow"/></Grid></Border>
                            <ItemsControl ItemsSource="{Binding ActiveSessions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SessionCardViewModel"><Border Classes="table-row" Padding="10,9"><Grid ColumnDefinitions="60,1.2*,0.9*,0.8*,0.65*,0.7*,1*,0.8*"><TextBlock Text="{Binding ComputerLabel}" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="11"/><TextBlock Grid.Column="2" Text="{Binding Game}" FontSize="11" Classes="muted"/><TextBlock Grid.Column="3" Text="{Binding TariffName}" FontSize="11"/><TextBlock Grid.Column="4" Text="{Binding StartedAtText}" FontSize="11" Classes="muted"/><TextBlock Grid.Column="5" Text="{Binding DurationText}" FontSize="11"/><TextBlock Grid.Column="6" Text="{Binding RemainingText}" FontSize="11" Foreground="{Binding StatusColor}"/><Border Grid.Column="7" Background="#202A1B" CornerRadius="8" Padding="6,3" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusColor}"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Border Padding="13" IsVisible="{Binding HasNoSessions}"><TextBlock Text="Немає активних сеансів. Запустіть новий сеанс, щоб він з’явився тут." Classes="muted" FontSize="12"/></Border>
                        </StackPanel></Border>
                        <Grid ColumnDefinitions="1.5*,0.9*" ColumnSpacing="12">
                            <Border Classes="panel" Padding="13"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="Завантаженість залу" Classes="section-title" FontSize="15"/><TextBlock Text="{Binding OccupancyText}" Classes="muted" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="Сьогодні" Classes="muted" FontSize="11"/></Grid><ItemsControl ItemsSource="{Binding HourlyOccupancy}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OccupancyBarViewModel"><Grid RowDefinitions="Auto,56,Auto" Margin="2,0"><TextBlock Text="{Binding CountText}" FontSize="10" Classes="muted" HorizontalAlignment="Center"/><Border Grid.Row="1" Background="{Binding BarColor}" CornerRadius="4,4,0,0" Width="22" Height="{Binding BarHeight}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/><TextBlock Grid.Row="2" Text="{Binding HourLabel}" FontSize="10" Classes="muted" HorizontalAlignment="Center" Margin="0,3,0,0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding ActiveCount, StringFormat='{}{0} активні'}" FontSize="10" Classes="muted"/><TextBlock Text="·" FontSize="10" Classes="muted"/><TextBlock Text="{Binding FreeCount, StringFormat='{}{0} вільні'}" FontSize="10" Classes="muted"/><TextBlock Text="·" FontSize="10" Classes="muted"/><TextBlock Text="{Binding ReservedCount, StringFormat='{}{0} бронь'}" FontSize="10" Classes="muted"/></StackPanel></StackPanel></Border>
                            <Border Grid.Column="1" Classes="panel" Padding="13"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Найближче бронювання" Classes="section-title" FontSize="15"/><Button Grid.Column="1" Classes="window-control" Content="→" Command="{Binding ShowBookingsCommand}"/></Grid><StackPanel IsVisible="{Binding HasUpcomingReservation}" Spacing="4"><TextBlock Text="{Binding NextReservation.StartText}" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding NextReservation.ClientName}" FontSize="12"/><TextBlock Text="{Binding NextReservation.ComputerLabel}" FontSize="11" Classes="muted"/><TextBlock Text="{Binding NextReservation.DurationText}" FontSize="11" Classes="muted"/><Button Classes="secondary" Command="{Binding ShowBookingsCommand}" Content="Відкрити бронювання  →"/></StackPanel><TextBlock Text="Майбутніх бронювань немає." Classes="muted" FontSize="11" IsVisible="{Binding HasNoUpcomingReservation}"/></StackPanel></Border>
                        </Grid>
                        <Border Classes="panel" Padding="12" IsVisible="{Binding IsNotificationPanelOpen}"><StackPanel Spacing="6"><TextBlock Text="Сповіщення зміни" Classes="section-title"/><ItemsControl ItemsSource="{Binding Notifications}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClubNotification"><Grid ColumnDefinitions="*,Auto" Margin="0,3"><StackPanel Spacing="2"><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Classes="secondary" Padding="6,4" Content="{Binding ReadText}" IsEnabled="{Binding CanMarkRead}" Command="{Binding $parent[Window].DataContext.AcknowledgeNotificationCommand}" CommandParameter="{Binding Id}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDashboardCompact}" Spacing="10">
                        <TextBlock Text="{Binding CurrentClubText}" Classes="muted" FontSize="11"/>
                        <Border Classes="panel" Padding="13"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="Нараховано сьогодні" FontSize="11" Classes="muted"/><TextBlock Grid.Column="1" Text="↗" Foreground="#C7F36B"/><TextBlock Grid.Row="1" Text="{Binding TodayAccruedAmount}" FontSize="24" FontWeight="Bold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActiveAccruedAmount}" FontSize="11" Foreground="#C7F36B" VerticalAlignment="Bottom"/></Grid></Border>
                        <Border Classes="panel" Padding="12"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Завантаженість" FontSize="13" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding OccupancyPercent, StringFormat='{}{0:0}%'}" Foreground="#C7F36B" FontSize="12"/></Grid><Grid Height="7"><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ActiveSegmentWidth}"/><ColumnDefinition Width="{Binding FreeSegmentWidth}"/><ColumnDefinition Width="{Binding ReservedSegmentWidth}"/><ColumnDefinition Width="{Binding OfflineSegmentWidth}"/></Grid.ColumnDefinitions><Border Background="#C7F36B" CornerRadius="4,0,0,4"/><Border Grid.Column="1" Background="#252E3A"/><Border Grid.Column="2" Background="#72B8FF"/><Border Grid.Column="3" Background="#FFB454" CornerRadius="0,4,4,0"/></Grid><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="{Binding ActiveCount, StringFormat='{}{0} активних'}" FontSize="9" Classes="muted"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding FreeCount, StringFormat='{}{0} вільних'}" FontSize="9" Classes="muted"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding ReservedCount, StringFormat='{}{0} бронь'}" FontSize="9" Classes="muted"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding OfflineCount, StringFormat='{}{0} офлайн'}" FontSize="9" Classes="muted"/></StackPanel></StackPanel></Border>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Активні сеанси" Classes="section-title" FontSize="15"/><Button Grid.Column="1" Classes="window-control" Content="{Binding ActiveCount, StringFormat='Усі {0} →'}" Command="{Binding ShowSessionsCommand}"/></Grid>
                        <ItemsControl ItemsSource="{Binding ActiveSessions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SessionCardViewModel"><Border Classes="panel" Padding="11" Margin="0,0,0,5"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SessionTitleText}" FontSize="12" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10" Foreground="{Binding StatusColor}"/></Grid><TextBlock Text="{Binding ClientName}" FontSize="11"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ScheduleText}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding AccruedText}" FontSize="10" Foreground="#C7F36B"/></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="panel" Padding="11" Background="#1A2A3B" IsVisible="{Binding HasUpcomingReservation}"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><TextBlock Text="Найближче бронювання" FontSize="10" Foreground="#9CCBFF"/><TextBlock Grid.Column="1" Text="{Binding NextReservation.StartText}" FontSize="14" FontWeight="Bold"/><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0"><TextBlock Text="{Binding NextReservation.ComputerLabel}" FontSize="11"/><TextBlock Text="·" FontSize="11" Classes="muted"/><TextBlock Text="{Binding NextReservation.ClientName}" FontSize="11"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding NextReservation.DurationText}" FontSize="10" Classes="muted" Margin="0,3,0,0"/></Grid></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSessions}" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsWide}">
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="filter-chip" Classes.active="{Binding IsAllSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Усі" Content="{Binding ActiveCount, StringFormat='Усі · {0}'}" Margin="0,0,5,0"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsActiveSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Активні" Content="{Binding ActiveRunningCount, StringFormat='Активні · {0}'}" Margin="0,0,5,0"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsExpiringSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Менше 15 хв" Content="{Binding SessionsUnder15Count, StringFormat='Менше 15 хв · {0}'}" Margin="0,0,5,0"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsOverdueSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Потрібна увага" Content="{Binding OverdueSessionCount, StringFormat='Потрібна увага · {0}'}"/>
                            </WrapPanel>
                            <TextBox Grid.Column="1" Width="230" PlaceholderText="⌕  Пошук за ім’ям або ПК" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <StackPanel IsVisible="{Binding IsCompact}" Spacing="7">
                            <TextBox PlaceholderText="⌕  Пошук за клієнтом, грою або ПК" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="filter-chip" Classes.active="{Binding IsAllSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Усі" Content="{Binding ActiveCount, StringFormat='Усі · {0}'}" Margin="0,0,5,5"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsActiveSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Активні" Content="{Binding ActiveRunningCount, StringFormat='Активні · {0}'}" Margin="0,0,5,5"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsExpiringSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Менше 15 хв" Content="{Binding SessionsUnder15Count, StringFormat='Менше 15 хв · {0}'}" Margin="0,0,5,5"/>
                                <Button Classes="filter-chip" Classes.active="{Binding IsOverdueSessionFilter}" Command="{Binding SetSessionFilterCommand}" CommandParameter="Потрібна увага" Content="{Binding OverdueSessionCount, StringFormat='Потрібна увага · {0}'}" Margin="0,0,5,5"/>
                            </WrapPanel>
                        </StackPanel>
                        <Border IsVisible="{Binding HasUrgentSessions}" Background="#342819" BorderBrush="#634A2D" BorderThickness="1" CornerRadius="8" Padding="9"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="!" Foreground="#FFB454" FontWeight="Bold"/><TextBlock Text="{Binding SessionAttentionText}" FontSize="11" Foreground="#F2C48D"/></StackPanel></Border>
                        <Border Classes="panel" Padding="0" IsVisible="{Binding ShowWideSessionTable}"><StackPanel><Border Classes="table-header" Padding="9,7"><Grid ColumnDefinitions="55,0.9*,1.2*,0.8*,0.6*,0.8*,0.8*,0.8*,Auto,Auto"><TextBlock Text="ПК / ГРА" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="КЛІЄНТ" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="ТАРИФ" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="СТАРТ" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="ЧАС" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="ЗАЛИШИЛОСЬ" Classes="eyebrow"/><TextBlock Grid.Column="6" Text="НАРАХОВАНО" Classes="eyebrow"/><TextBlock Grid.Column="7" Text="СТАТУС" Classes="eyebrow"/><TextBlock Grid.Column="8" Text="ДОДАТИ" Classes="eyebrow"/><TextBlock Grid.Column="9" Text="ДІЯ" Classes="eyebrow"/></Grid></Border><ItemsControl ItemsSource="{Binding ActiveSessions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SessionCardViewModel"><Border Classes="table-row" Padding="9,7"><Grid ColumnDefinitions="55,0.9*,1.2*,0.8*,0.6*,0.8*,0.8*,0.8*,Auto,Auto"><StackPanel Spacing="1"><TextBlock Text="{Binding ComputerLabel}" FontSize="10" FontWeight="Bold"/><TextBlock Text="{Binding Game}" FontSize="9" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="10" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Spacing="1"><TextBlock Text="{Binding TariffName}" FontSize="10"/><TextBlock Text="{Binding TariffRateText}" FontSize="9" Classes="muted"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding StartedAtText}" FontSize="10" Classes="muted" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="10" VerticalAlignment="Center"/><TextBlock Grid.Column="5" Text="{Binding RemainingText}" FontSize="10" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/><TextBlock Grid.Column="6" Text="{Binding AccruedText}" FontSize="10" Foreground="#C7F36B" VerticalAlignment="Center"/><TextBlock Grid.Column="7" Text="{Binding StatusText}" FontSize="9" Foreground="{Binding StatusColor}" VerticalAlignment="Center"/><Button Grid.Column="8" Classes="secondary" Padding="5,3" Content="+30 хв" Command="{Binding ExtendCommand}"/><Button Grid.Column="9" Classes="primary" Padding="5,3" Content="Завершити" Command="{Binding EndCommand}" Margin="3,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <ItemsControl ItemsSource="{Binding ActiveSessions}" IsVisible="{Binding IsCompact}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:SessionCardViewModel"><Border Classes="panel" Padding="11" Margin="0,0,0,6"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SessionTitleText}" FontSize="12" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10"/></Grid><TextBlock Text="{Binding ClientName}" FontSize="11"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ScheduleText}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding AccruedText}" FontSize="10" Foreground="#C7F36B"/></Grid><TextBlock Text="{Binding RemainingText}" FontSize="10" Foreground="{Binding StatusColor}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5"><Button Classes="secondary" Padding="6,4" Content="+30 хв" Command="{Binding ExtendCommand}"/><Button Classes="primary" Padding="6,4" Content="Завершити" Command="{Binding EndCommand}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="empty-state" Padding="15" IsVisible="{Binding HasNoSessions}">
                            <Grid ColumnDefinitions="38,*" ColumnSpacing="10">
                                <Border Width="34" Height="34" CornerRadius="9" Background="#26341A" VerticalAlignment="Top">
                                    <TextBlock Text="◉" Foreground="#C7F36B" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Активних сеансів за цими умовами не знайдено" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Змініть фільтр або запустіть новий сеанс, щоб він з’явився у списку." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                                    <Button Classes="secondary" Command="{Binding StartSessionCommand}" Content="＋  Почати сеанс" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsBookings}" Spacing="11">
                        <Border Classes="panel" Padding="12" IsVisible="{Binding IsWide}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="Розклад залу" Classes="section-title" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="secondary" Padding="7,5" Content="‹" Command="{Binding PreviousBookingDayCommand}" Margin="0,0,4,0"/>
                                    <Border Grid.Column="2" Classes="panel" Padding="8,5" Margin="0,0,4,0"><TextBlock Text="{Binding SelectedBookingDateText}" FontSize="10" VerticalAlignment="Center"/></Border>
                                    <Button Grid.Column="3" Classes="secondary" Padding="7,5" Content="›" Command="{Binding NextBookingDayCommand}" Margin="0,0,7,0"/>
                                    <Button Grid.Column="4" Classes="secondary" Content="＋ Створити слот" Command="{Binding ShowNewReservationDialogCommand}"/>
                                </Grid>
                                <Grid ColumnDefinitions="65,*,*,*,*,*,*">
                                    <TextBlock Grid.Column="1" Text="18:00" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Grid.Column="2" Text="19:00" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="20:00" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Grid.Column="4" Text="21:00" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Grid.Column="5" Text="22:00" Classes="eyebrow" HorizontalAlignment="Center"/><TextBlock Grid.Column="6" Text="23:00" Classes="eyebrow" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ReservationsForSelectedDay}">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ReservationCard">
                                        <Grid ColumnDefinitions="65,*,*,*,*,*,*" Height="31" Margin="0,2">
                                            <TextBlock Text="{Binding ComputerLabel}" FontSize="10" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="#10151C" BorderBrush="#202630" BorderThickness="0,0,1,0"/><Border Grid.Column="2" Background="#10151C" BorderBrush="#202630" BorderThickness="0,0,1,0"/><Border Grid.Column="3" Background="#10151C" BorderBrush="#202630" BorderThickness="0,0,1,0"/><Border Grid.Column="4" Background="#10151C" BorderBrush="#202630" BorderThickness="0,0,1,0"/><Border Grid.Column="5" Background="#10151C" BorderBrush="#202630" BorderThickness="0,0,1,0"/><Border Grid.Column="6" Background="#10151C"/>
                                            <Border Grid.Column="{Binding TimelineColumn}" Grid.ColumnSpan="{Binding TimelineColumnSpan}" Background="#1C3953" CornerRadius="5" Padding="4,2" Margin="2"><TextBlock Text="{Binding TimelineText}" FontSize="9" Foreground="#A9D2FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Border>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Немає бронювань на цей день." IsVisible="{Binding HasNoReservationsForSelectedDay}" FontSize="10" Classes="muted"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="panel" Padding="0" IsVisible="{Binding IsWide}">
                            <StackPanel>
                                <Border Classes="table-header" Padding="10,7"><Grid ColumnDefinitions="1.2*,1*,0.7*,0.8*,0.7*,Auto,Auto"><TextBlock Text="КЛІЄНТ" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="ПК" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="ЧАС" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="ТРИВАЛІСТЬ" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="СТАТУС" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="ДІЇ" Classes="eyebrow"/></Grid></Border>
                                <ItemsControl ItemsSource="{Binding ReservationsForSelectedDay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ReservationCard"><Border Classes="table-row" Padding="10,8"><Grid ColumnDefinitions="1.2*,1*,0.7*,0.8*,0.7*,Auto,Auto"><TextBlock Text="{Binding ClientName}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding ComputerLabel}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding TimeRangeText}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="10"/><TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="9" Foreground="#72B8FF"/><Button Grid.Column="5" Classes="secondary" Padding="5,3" Content="Змінити" Command="{Binding $parent[Window].DataContext.EditReservationCommand}" CommandParameter="{Binding Id}"/><Button Grid.Column="6" Classes="window-control" Content="×" Command="{Binding $parent[Window].DataContext.CancelReservationCommand}" CommandParameter="{Binding Id}" Margin="3,0,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <StackPanel IsVisible="{Binding IsCompact}" Spacing="9">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Classes="secondary" Padding="8,7" Command="{Binding PreviousBookingDayCommand}" Content="‹"/>
                                <Border Grid.Column="1" Classes="panel" Margin="7,0" Padding="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedBookingDateText}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="▦" Foreground="#C7F36B" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
                                <Button Grid.Column="2" Classes="secondary" Padding="8,7" Command="{Binding NextBookingDayCommand}" Content="›"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedDayReservationCount, StringFormat='Сьогодні · {0} бронювань'}" Classes="muted" FontSize="10"/><Button Grid.Column="1" Classes="window-control" Content="Найближчі" Foreground="#72B8FF" Command="{Binding ShowDashboardCommand}"/></Grid>
                            <ItemsControl ItemsSource="{Binding ReservationsForSelectedDay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ReservationCard">
                                <Border Classes="panel" Padding="11" Margin="0,0,0,2"><StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TimeRangeText}" FontSize="13" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C3953" CornerRadius="6" Padding="6,3"><TextBlock Text="{Binding DurationText}" FontSize="9" Foreground="#A9D2FF"/></Border></Grid>
                                    <TextBlock Text="{Binding ClientName}" FontSize="11" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ComputerLabel}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" Foreground="#72B8FF"/></Grid>
                                    <Button Classes="secondary" Command="{Binding $parent[Window].DataContext.EditReservationCommand}" CommandParameter="{Binding Id}" Content="Змінити бронювання"/>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Border Classes="panel" Padding="11" IsVisible="{Binding HasNoReservationsForSelectedDay}"><TextBlock Text="Бронювань поки немає. Створіть слот для клієнта." Classes="muted" FontSize="11"/></Border>
                            <Border Background="#121820" BorderBrush="#242B36" BorderThickness="1" CornerRadius="8" Padding="10"><TextBlock Text="Бронювання резервує час у розкладі. Нарахування почнеться лише після створення сеансу." FontSize="10" Classes="muted" TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsComputers}" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsWide}"><StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><Border Background="#1C252F" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding ComputerCount, StringFormat='Усі · {0}'}" FontSize="10"/></Border><Border Background="#1C252F" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding ActiveCount, StringFormat='Активні · {0}'}" FontSize="10"/></Border><Border Background="#1C252F" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding FreeCount, StringFormat='Вільні · {0}'}" FontSize="10"/></Border><Border Background="#1C252F" CornerRadius="6" Padding="7,4"><TextBlock Text="{Binding ReservedCount, StringFormat='Бронь · {0}'}" FontSize="10"/></Border></StackPanel><Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleArchivedComputersCommand}" Content="{Binding ComputerArchiveToggleText}" Margin="8,0"/><TextBox Grid.Column="2" Width="200" PlaceholderText="⌕ Пошук за назвою ПК" Text="{Binding ComputerFilterText, UpdateSourceTrigger=PropertyChanged}"/></Grid>
                        <StackPanel IsVisible="{Binding IsCompact}" Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBox PlaceholderText="⌕  Пошук за ПК або характеристикою" Text="{Binding ComputerFilterText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleArchivedComputersCommand}" Content="{Binding ComputerArchiveToggleText}" Margin="6,0,0,0"/></Grid><TextBlock Text="{Binding ComputerCount, StringFormat='Робочі місця · {0}'}" Classes="muted" FontSize="10"/></StackPanel>                        <ItemsControl ItemsSource="{Binding VisibleComputers}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ResponsiveCardColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ComputerCard"><Border Classes="panel" Margin="0,0,7,7" Padding="9"><StackPanel Spacing="4"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="▣" Foreground="#AAB8CE" FontSize="10"/><TextBlock Text="{Binding ComputerLabel}" FontSize="11" FontWeight="Bold"/></StackPanel><Border Grid.Column="1" Background="#202A1B" CornerRadius="6" Padding="4,2"><TextBlock Text="{Binding ManagementStatusText}" FontSize="9" Foreground="{Binding ManagementStatusColor}"/></Border></Grid><TextBlock Text="{Binding Zone}" FontSize="9" Classes="muted"/><Border Height="1" Background="#242B36" Margin="0,2"/><TextBlock Text="{Binding Processor, StringFormat='CPU  {0}'}" FontSize="9" TextWrapping="Wrap"/><TextBlock Text="{Binding GraphicsCard, StringFormat='GPU  {0}'}" FontSize="9" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding Memory, StringFormat='RAM  {0}'}" FontSize="9" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding Monitor}" FontSize="9" Classes="muted"/></Grid><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="3"><Ellipse Width="4" Height="4" Fill="{Binding AgentConnectionColor}" VerticalAlignment="Center"/><TextBlock Text="{Binding AgentConnectionText}" FontSize="9" Foreground="{Binding AgentConnectionColor}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"><Button Classes="window-control" Content="✎" Padding="3" IsVisible="{Binding CanEdit}" Command="{Binding $parent[Window].DataContext.EditComputerCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="Редагувати ПК"/><Button Classes="window-control" Content="{Binding ArchiveActionText}" Padding="3" Command="{Binding $parent[Window].DataContext.ToggleComputerArchiveCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="{Binding ArchiveActionTooltip}"/><Button Classes="window-control" Content="···" Padding="3" IsVisible="{Binding CanEdit}" Command="{Binding $parent[Window].DataContext.ConfigureComputerAgentCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="Налаштувати PC-агент"/></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="panel" Padding="12" IsVisible="{Binding HasNoComputers}"><TextBlock Text="{Binding ComputerEmptyStateText}" Classes="muted" FontSize="11"/></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsClients}" Spacing="10">
                        <UniformGrid Columns="{Binding ResponsiveMetricColumns}">
                            <Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="72"><StackPanel Spacing="2"><TextBlock Text="КЛІЄНТИ У БАЗІ" Classes="eyebrow"/><TextBlock Text="{Binding Clients.Count}" FontSize="18" Foreground="#C7F36B"/><TextBlock Text="Зареєстровані клієнти" FontSize="9" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="72"><StackPanel Spacing="2"><TextBlock Text="НОВИХ ЦЬОГО МІСЯЦЯ" Classes="eyebrow"/><TextBlock Text="{Binding NewClientsThisMonth}" FontSize="18"/><TextBlock Text="Нові профілі" FontSize="9" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="72"><StackPanel Spacing="2"><TextBlock Text="ВІЗИТІВ ЦЬОГО МІСЯЦЯ" Classes="eyebrow"/><TextBlock Text="{Binding VisitsThisMonth}" FontSize="18"/><TextBlock Text="За всі сеанси" FontSize="9" Classes="muted"/></StackPanel></Border>
                            <Border Classes="metric" Padding="9" Height="72"><StackPanel Spacing="2"><TextBlock Text="БАЛАНС КЛІЄНТІВ" Classes="eyebrow"/><TextBlock Text="{Binding TotalClientBalance}" FontSize="18" Foreground="#72B8FF"/><TextBlock Text="На рахунках" FontSize="9" Classes="muted"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid ColumnDefinitions="*,Auto,Auto"><TextBox PlaceholderText="⌕ Пошук клієнта або телефону" Text="{Binding ClientFilterText, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleArchivedClientsCommand}" Content="{Binding ClientArchiveToggleText}" Margin="8,0"/><TextBlock Grid.Column="2" Text="{Binding VisibleClients.Count}" Classes="muted" FontSize="10" VerticalAlignment="Center" Margin="4,0"/></Grid>
                        <Border Classes="panel" Padding="0" IsVisible="{Binding IsWide}">
                            <StackPanel>
                                <Border Classes="table-header" Padding="10,7"><Grid ColumnDefinitions="1.2*,1.1*,0.9*,0.65*,1*,0.7*,Auto"><TextBlock Text="КЛІЄНТ" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="ТЕЛЕФОН" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="БАЛАНС" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="ВІЗИТИ" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="ОСТАННІЙ ВІЗИТ" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="СТАТУС" Classes="eyebrow"/><TextBlock Grid.Column="6" Text="ДІЇ" Classes="eyebrow"/></Grid></Border>
                                <ItemsControl ItemsSource="{Binding VisibleClients}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClientCard"><Border Classes="table-row" Padding="10,8"><Grid ColumnDefinitions="1.2*,1.1*,0.9*,0.65*,1*,0.7*,Auto"><TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Phone}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding AccountBalanceText}" FontSize="10" Foreground="#C7F36B"/><TextBlock Grid.Column="3" Text="{Binding Visits}" FontSize="10"/><TextBlock Grid.Column="4" Text="{Binding LastVisitText}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="5" Text="{Binding ManagementStatusText}" FontSize="9" Foreground="{Binding ManagementStatusColor}"/><StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"><Button Classes="window-control" Content="✎" Padding="3" IsVisible="{Binding CanEdit}" Command="{Binding $parent[Window].DataContext.EditClientCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="Редагувати клієнта"/><Button Classes="window-control" Content="{Binding ArchiveActionText}" Padding="3" Command="{Binding $parent[Window].DataContext.ToggleClientArchiveCommand}" CommandParameter="{Binding Id}" ToolTip.Tip="{Binding ArchiveActionTooltip}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding VisibleClients}" IsVisible="{Binding IsCompact}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:ClientCard"><Border Classes="panel" Padding="10" Margin="0,0,0,5"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding AccountBalanceText}" Foreground="#C7F36B" FontSize="10"/><TextBlock Grid.Row="1" Text="{Binding Phone}" Classes="muted" FontSize="10" Margin="0,3,0,0"/><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="3" Margin="0,3,0,0"><TextBlock Text="{Binding LastVisitText}" FontSize="9" Classes="muted"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding VisitsText}" FontSize="9" Classes="muted"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding ManagementStatusText}" FontSize="9" Foreground="{Binding ManagementStatusColor}"/></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,6,0,0"><Button Classes="secondary" Padding="7,4" Content="Редагувати" IsVisible="{Binding CanEdit}" Command="{Binding $parent[Window].DataContext.EditClientCommand}" CommandParameter="{Binding Id}"/><Button Classes="secondary" Padding="7,4" Content="{Binding ArchiveActionText}" ToolTip.Tip="{Binding ArchiveActionTooltip}" Command="{Binding $parent[Window].DataContext.ToggleClientArchiveCommand}" CommandParameter="{Binding Id}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="panel" Padding="10" IsVisible="{Binding HasNoClients}"><TextBlock Text="{Binding ClientEmptyStateText}" Classes="muted" FontSize="11"/></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTariffs}" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding VisibleTariffs.Count, StringFormat='Тарифи у списку · {0}'}" Classes="muted" FontSize="11"/><Button Grid.Column="1" Classes="secondary" Command="{Binding ToggleArchivedTariffsCommand}" Content="{Binding TariffArchiveToggleText}" Margin="8,0"/><TextBlock Grid.Column="2" Text="Нарахування пропорційно використаному часу" Classes="muted" FontSize="10"/></Grid>
                        <ItemsControl ItemsSource="{Binding VisibleTariffs}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ResponsiveCardColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:TariffCard"><Border Classes="panel" Margin="0,0,7,0" Padding="11"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="◉" Foreground="#C7F36B" FontSize="13"/><Border Grid.Column="1" Background="#202A1B" CornerRadius="6" Padding="4,2"><TextBlock Text="{Binding Badge}" Foreground="#C7F36B" FontSize="9"/></Border></Grid><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"/><TextBlock Text="АРХІВ" FontSize="9" Foreground="#FFB454" IsVisible="{Binding IsArchived}"/><TextBlock Text="{Binding DurationText}" FontSize="11" Classes="muted"/><TextBlock Text="{Binding Description}" FontSize="10" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding Availability}" FontSize="9" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="{Binding PriceText}" FontSize="19" FontWeight="Bold"/><TextBlock Text="₴ / пакет" FontSize="10" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3"/></StackPanel><TextBlock Text="{Binding HourlyPriceText, StringFormat='{}{0} ₴ / год'}" FontSize="10" Foreground="#C7F36B"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="0,5,0,0"><Button Classes="secondary" Padding="7,4" Content="Редагувати" IsVisible="{Binding CanEdit}" Command="{Binding $parent[Window].DataContext.EditTariffCommand}" CommandParameter="{Binding Id}"/><Button Classes="window-control" Padding="5" Content="{Binding ArchiveActionText}" ToolTip.Tip="{Binding ArchiveActionTooltip}" Command="{Binding $parent[Window].DataContext.ToggleTariffArchiveCommand}" CommandParameter="{Binding Id}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="panel" Padding="12" IsVisible="{Binding HasNoTariffs}"><TextBlock Text="{Binding TariffEmptyStateText}" Classes="muted" FontSize="11"/></Border><Border Classes="panel" Padding="12"><StackPanel Spacing="7"><TextBlock Text="Правила нарахування" Classes="section-title" FontSize="14"/><UniformGrid Columns="3"><StackPanel Spacing="3" Margin="0,0,6,0"><TextBlock Text="◷ Використаний час" FontSize="10" Foreground="#C7F36B"/><TextBlock Text="Вартість обчислюється за фактичний час та тариф." FontSize="9" Classes="muted" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="3" Margin="0,0,6,0"><TextBlock Text="◇ Прозорі умови" FontSize="10" Foreground="#72B8FF"/><TextBlock Text="Тривалість і ціна фіксуються під час старту." FontSize="9" Classes="muted" TextWrapping="Wrap"/></StackPanel><StackPanel Spacing="3"><TextBlock Text="▣ Облік вартості" FontSize="10" Foreground="#C7F36B"/><TextBlock Text="Нарахування не є фактичною оплатою." FontSize="9" Classes="muted" TextWrapping="Wrap"/></StackPanel></UniformGrid></StackPanel></Border>
                        <Border Background="#1A2A3B" CornerRadius="7" Padding="8"><TextBlock Text="Система не приймає платежі та не списує кошти." FontSize="10" Foreground="#A9D2FF"/></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsHistory}" Spacing="10">
                        <UniformGrid Columns="{Binding ResponsiveMetricColumns}"><Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="70"><StackPanel Spacing="2"><TextBlock Text="ЗАВЕРШЕНО СЬОГОДНІ" Classes="eyebrow"/><TextBlock Text="{Binding HistoryTodayCount}" FontSize="17" Foreground="#C7F36B"/><TextBlock Text="Сеансів у журналі" FontSize="9" Classes="muted"/></StackPanel></Border><Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="70"><StackPanel Spacing="2"><TextBlock Text="ЧАС СЬОГОДНІ" Classes="eyebrow"/><TextBlock Text="{Binding HistoryHoursToday}" FontSize="17"/><TextBlock Text="Завершені сеанси" FontSize="9" Classes="muted"/></StackPanel></Border><Border Classes="metric" Margin="0,0,7,0" Padding="9" Height="70"><StackPanel Spacing="2"><TextBlock Text="НАРАХОВАНО СЬОГОДНІ" Classes="eyebrow"/><TextBlock Text="{Binding TodayAccruedAmount}" FontSize="17" Foreground="#C7F36B"/><TextBlock Text="За тарифами клубу" FontSize="9" Classes="muted"/></StackPanel></Border><Border Classes="metric" Padding="9" Height="70"><StackPanel Spacing="2"><TextBlock Text="АКТИВНІ СЕАНСИ" Classes="eyebrow"/><TextBlock Text="{Binding ActiveAccruedAmount}" FontSize="17" Foreground="#72B8FF"/><TextBlock Text="Поточні нарахування" FontSize="9" Classes="muted"/></StackPanel></Border></UniformGrid>
                        <TextBox PlaceholderText="⌕  Клієнт або гра" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Classes="panel" Padding="0" IsVisible="{Binding IsWide}"><StackPanel><Border Classes="table-header" Padding="10,7"><Grid ColumnDefinitions="50,1.1*,1.1*,0.8*,0.9*,0.65*,0.8*,0.8*"><TextBlock Text="ПК" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="КЛІЄНТ" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="ГРА" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="ТАРИФ" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="ПОЧАТОК / КІНЕЦЬ" Classes="eyebrow"/><TextBlock Grid.Column="5" Text="ТРИВАЛІСТЬ" Classes="eyebrow"/><TextBlock Grid.Column="6" Text="НАРАХОВАНО" Classes="eyebrow"/><TextBlock Grid.Column="7" Text="БАЛИ" Classes="eyebrow"/></Grid></Border><ItemsControl ItemsSource="{Binding HistorySessions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:HistorySessionCard"><Border Classes="table-row" Padding="10,8"><Grid ColumnDefinitions="50,1.1*,1.1*,0.8*,0.9*,0.65*,0.8*,0.8*"><TextBlock Text="{Binding ComputerLabel}" FontSize="10"/><TextBlock Grid.Column="1" Text="{Binding ClientName}" FontSize="10"/><TextBlock Grid.Column="2" Text="{Binding Game}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="3" Text="{Binding TariffName}" FontSize="10"/><TextBlock Grid.Column="4" Text="{Binding PeriodText}" FontSize="9" Classes="muted"/><TextBlock Grid.Column="5" Text="{Binding DurationText}" FontSize="9"/><TextBlock Grid.Column="6" Text="{Binding AmountText}" FontSize="10" Foreground="#C7F36B"/><TextBlock Grid.Column="7" Text="{Binding PointsText}" FontSize="9" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <ItemsControl ItemsSource="{Binding HistorySessions}" IsVisible="{Binding IsCompact}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:HistorySessionCard"><Border Classes="panel" Padding="10" Margin="0,0,0,5"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"><TextBlock Text="{Binding ComputerLabel}" FontSize="10" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding AmountText}" Foreground="#C7F36B" FontSize="10"/><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="3" Margin="0,3,0,0"><TextBlock Text="{Binding ClientName}" FontSize="9"/><TextBlock Text="·" FontSize="9" Classes="muted"/><TextBlock Text="{Binding Game}" FontSize="9" Classes="muted"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding PeriodText}" FontSize="9" Classes="muted" Margin="0,3,0,0"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Border Classes="panel" Padding="11" IsVisible="{Binding HasNoHistory}"><TextBlock Text="Завершених сеансів поки немає." Classes="muted" FontSize="11"/></Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSettings}" Spacing="10"><Border Classes="panel" Padding="13"><StackPanel Spacing="4"><TextBlock Text="Зберігання даних" Classes="section-title"/><TextBlock Text="Дані клубу зберігаються локально у SQLite на цьому комп’ютері. База не синхронізується автоматично між робочими станціями." FontSize="11" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border><Border Classes="panel" Padding="13"><StackPanel Spacing="6"><TextBlock Text="Робочі місця та агенти" Classes="section-title"/><TextBlock Text="{Binding AgentSummaryText}" FontSize="11"/><TextBlock Text="Мережевий стан доступний лише для ПК з налаштованим агентом." FontSize="10" Classes="muted"/><Button Classes="secondary" Command="{Binding ShowComputersCommand}" Content="Відкрити комп’ютери" HorizontalAlignment="Left"/></StackPanel></Border><Border Classes="panel" Padding="13"><StackPanel Spacing="6"><TextBlock Text="Розділи системи" Classes="section-title"/><WrapPanel><Button Classes="secondary" Margin="0,0,5,5" Command="{Binding ShowClientsCommand}" Content="Клієнти"/><Button Classes="secondary" Margin="0,0,5,5" Command="{Binding ShowTariffsCommand}" Content="Тарифи"/><Button Classes="secondary" Margin="0,0,5,5" Command="{Binding ShowHistoryCommand}" Content="Історія"/></WrapPanel></StackPanel></Border></StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="10" Classes="muted" Margin="18,2,18,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasStatusMessage}"/>
        </Grid>

        <StackPanel Grid.Column="1" Grid.Row="1" IsVisible="{Binding IsCompact}" Background="#10141B">
            <Button Classes="primary" Margin="14,7,14,5" Padding="11,8" Command="{Binding StartSessionCommand}" Content="＋  Новий сеанс" IsVisible="{Binding IsMobileStartAction}"/>
            <Button Classes="primary" Margin="14,7,14,5" Padding="11,8" Command="{Binding ShowNewReservationDialogCommand}" Content="＋  Створити бронювання" IsVisible="{Binding IsMobileBookingAction}"/>
            <Button Classes="primary" Margin="14,7,14,5" Padding="11,8" Command="{Binding ShowNewComputerDialogCommand}" Content="＋  Додати комп’ютер" IsVisible="{Binding IsMobileComputerAction}"/>
            <Button Classes="primary" Margin="14,7,14,5" Padding="11,8" Command="{Binding ShowNewClientDialogCommand}" Content="＋  Додати клієнта" IsVisible="{Binding IsMobileClientAction}"/>
            <Button Classes="primary" Margin="14,7,14,5" Padding="11,8" Command="{Binding ShowNewTariffDialogCommand}" Content="＋  Додати тариф" IsVisible="{Binding IsMobileTariffAction}"/>
            <Border BorderBrush="#242B36" BorderThickness="0,1,0,0" Padding="4"><UniformGrid Columns="4"><Button Classes="nav" Classes.active="{Binding IsDashboard}" Padding="0,6" Command="{Binding ShowDashboardCommand}" Content="▦&#10;Огляд" FontSize="11"/><Button Classes="nav" Classes.active="{Binding IsSessions}" Padding="0,6" Command="{Binding ShowSessionsCommand}" Content="◉&#10;Сеанси" FontSize="11"/><Button Classes="nav" Classes.active="{Binding IsBookings}" Padding="0,6" Command="{Binding ShowBookingsCommand}" Content="▣&#10;Броні" FontSize="11"/><Button Classes="nav" Classes.active="{Binding IsComputers}" Padding="0,6" Command="{Binding ShowComputersCommand}" Content="▤&#10;ПК" FontSize="11"/></UniformGrid></Border>
        </StackPanel>
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsStartDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" BorderBrush="#242B36" BorderThickness="0,0,0,1" Padding="20,18,20,14">
                        <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◷" Foreground="#C7F36B" FontSize="20"/><StackPanel Spacing="3"><TextBlock Text="Новий сеанс" Classes="section-title" FontSize="20"/><TextBlock Text="Оберіть вільний ПК та параметри обліку часу." Classes="muted" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Classes="window-control" Command="{Binding CancelStartSessionCommand}" Content="×" VerticalAlignment="Top"/></Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="490" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16" Spacing="13">
                            <StackPanel Spacing="5"><TextBlock Text="Комп’ютер" FontSize="11"/><ComboBox ItemsSource="{Binding AvailableComputers}" SelectedItem="{Binding SelectedComputer}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:ComputerCard"><TextBlock Text="{Binding ChoiceText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <StackPanel Spacing="5"><TextBlock Text="Клієнт" FontSize="11"/><ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:ClientCard"><TextBlock Text="{Binding ChoiceText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="5"><TextBlock Text="Тариф" FontSize="11"/><ComboBox ItemsSource="{Binding Tariffs}" SelectedItem="{Binding SelectedTariff}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:TariffCard"><TextBlock Text="{Binding ChoiceText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Тривалість" FontSize="11"/><ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedDuration}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:DurationChoice"><TextBlock Text="{Binding DisplayText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*"><TextBlock Text="{Binding SessionStartTimeText, StringFormat='Початок {0}'}" FontSize="10" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding SessionEndTimeText, StringFormat='Завершення {0}'}" FontSize="10" Classes="muted" HorizontalAlignment="Right"/></Grid>
                            <Border Background="#26341A" CornerRadius="9" Padding="13"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="Орієнтовне нарахування" FontSize="11"/><TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding EstimatedCostText}" Foreground="#C7F36B" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="За повну тривалість; фактичне нарахування за використаний час. Не є оплатою." Classes="muted" FontSize="10" TextWrapping="Wrap" Margin="0,6,12,0"/></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#242B36" BorderThickness="0,1,0,0" Padding="20,12"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="LEOPARD · Київ / Поділ" Classes="muted" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Command="{Binding CancelStartSessionCommand}" Content="Скасувати" Margin="0,0,8,0"/><Button Grid.Column="2" Classes="primary" Command="{Binding ConfirmStartSessionCommand}" IsEnabled="{Binding CanConfirmStart}" Content="Почати сеанс"/></Grid></Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsNewClientDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" BorderBrush="#242B36" BorderThickness="0,0,0,1" Padding="20,18,20,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="♙" Foreground="#C7F36B" FontSize="20"/><StackPanel Spacing="3"><TextBlock Text="{Binding ClientDialogTitle}" Classes="section-title" FontSize="20"/><TextBlock Text="Новий профіль гостя у базі клубу." Classes="muted" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Classes="window-control" Command="{Binding CancelNewClientDialogCommand}" Content="×" VerticalAlignment="Top"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="510" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,16" Spacing="12">
                        <StackPanel Spacing="5"><TextBlock Text="Ім’я та прізвище" FontSize="11"/><TextBox PlaceholderText="Софія Мороз" Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Телефон" FontSize="11"/><TextBox PlaceholderText="+380 67 901 23 45" Text="{Binding NewClientPhone, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Електронна пошта · необов’язково" FontSize="11"/><TextBox PlaceholderText="name@example.com" Text="{Binding NewClientEmail, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Дата народження" FontSize="11"/><DatePicker SelectedDate="{Binding NewClientBirthDate}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Обліковий баланс" FontSize="11"/><TextBox Text="{Binding NewClientBalance, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="0 ₴"/></StackPanel></Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Примітка · необов’язково" FontSize="11"/><TextBox PlaceholderText="Додаткова інформація про клієнта" Text="{Binding NewClientNote, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <Border Background="#10151C" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="ⓘ" Classes="muted"/><TextBlock Text="Початковий баланс — внутрішній облік клубу. Створення профілю не виконує платіжних операцій." FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="{Binding NewClientErrorMessage}" IsVisible="{Binding HasClientFormError}" Foreground="#FF8D8D" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#242B36" BorderThickness="0,1,0,0" Padding="20,12"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="LEOPARD · Київ / Поділ" Classes="muted" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Command="{Binding CancelNewClientDialogCommand}" Content="Скасувати" Margin="0,0,8,0"/><Button Grid.Column="2" Classes="primary" Command="{Binding SaveNewClientCommand}" IsEnabled="{Binding CanSaveClient}" Content="{Binding ClientDialogAction}"/></Grid></Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsComputerDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="14" Padding="22">
                <ScrollViewer MaxHeight="760" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding ComputerDialogTitle}" Classes="section-title" FontSize="20" />
                                <TextBlock Text="Ідентифікація робочого місця та його характеристики."
                                           Classes="muted" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="secondary" Command="{Binding CancelNewComputerDialogCommand}" Content="✕" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="5"><TextBlock Text="Назва ПК" FontSize="11"/><TextBox PlaceholderText="ПК-13" Text="{Binding NewComputerLabel, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Зона" FontSize="11"/><ComboBox ItemsSource="{Binding ZoneOptions}" SelectedItem="{Binding NewComputerZone}"/></StackPanel>
                        </Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Мережеве ім’я" FontSize="11"/><TextBox PlaceholderText="LEOPARD-PC13" Text="{Binding NewComputerNetworkName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Процесор · CPU" FontSize="11"/><TextBox PlaceholderText="AMD Ryzen 7 7800X3D" Text="{Binding NewComputerProcessor}"/></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Відеокарта · GPU" FontSize="11"/><TextBox PlaceholderText="NVIDIA GeForce RTX 4060 · 8 ГБ" Text="{Binding NewComputerGraphicsCard}"/></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <StackPanel Spacing="5"><TextBlock Text="Оперативна пам’ять" FontSize="11"/><TextBox PlaceholderText="32 ГБ DDR5" Text="{Binding NewComputerMemory}"/></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Монітор" FontSize="11"/><TextBox PlaceholderText="24″ · 144 Гц" Text="{Binding NewComputerMonitor}"/></StackPanel>
                        </Grid>
                        <Border Background="#10151C" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="ⓘ" Classes="muted"/><TextBlock Text="Після додавання стан агента буде «Не підключено», доки ПК-агент не з’єднається із сервером клубу." FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="{Binding ComputerFormError}" Foreground="#FF8D8D" FontSize="14" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Classes="secondary" Command="{Binding CancelNewComputerDialogCommand}" Content="Скасувати" />
                            <Button Classes="primary" Command="{Binding SaveNewComputerCommand}" Content="{Binding ComputerDialogAction}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsTariffDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="14" Padding="22">
                <StackPanel Spacing="13">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding TariffDialogTitle}" Classes="section-title" FontSize="20" />
                            <TextBlock Text="Ціна визначає облікову вартість ігрового часу."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" Command="{Binding CancelNewTariffDialogCommand}" Content="✕" />
                    </Grid>
                    <StackPanel Spacing="5"><TextBlock Text="Назва тарифу" FontSize="11"/><TextBox PlaceholderText="4 години" Text="{Binding NewTariffName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="5"><TextBlock Text="Тривалість, хв" FontSize="11"/><TextBox PlaceholderText="240" Text="{Binding NewTariffDurationMinutes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Ціна за тривалість, ₴" FontSize="11"/><TextBox PlaceholderText="280" Text="{Binding NewTariffPrice, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>
                    <StackPanel Spacing="5"><TextBlock Text="Доступність" FontSize="11"/><ComboBox ItemsSource="{Binding TariffAvailabilityOptions}" SelectedItem="{Binding NewTariffAvailability}"/></StackPanel>
                    <StackPanel Spacing="5"><TextBlock Text="Опис · необов’язково" FontSize="11"/><TextBox PlaceholderText="Тривала гра для компанії" Text="{Binding NewTariffDescription}"/></StackPanel>
                    <Border Background="#26341A" CornerRadius="9" Padding="12"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="Еквівалент за годину" FontSize="11"/><TextBlock Grid.Column="1" Grid.RowSpan="2" Text="{Binding TariffHourlyEquivalentText}" Foreground="#C7F36B" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="{Binding TariffPackageDescription}" FontSize="10" Classes="muted" TextWrapping="Wrap" Margin="0,6,10,0"/></Grid></Border>
                    <Border Background="#10151C" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="ⓘ" Classes="muted"/><TextBlock Text="Новий тариф не змінює умови вже активних сеансів. Жодних платіжних операцій не виконується." FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                    <TextBlock Text="{Binding TariffFormError}" Foreground="#FF8D8D" FontSize="11" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Classes="secondary" Command="{Binding CancelNewTariffDialogCommand}" Content="Скасувати" />
                        <Button Classes="primary" Command="{Binding SaveNewTariffCommand}" Content="{Binding TariffDialogAction}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsReservationDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" BorderBrush="#242B36" BorderThickness="0,0,0,1" Padding="20,18,20,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="▣" Foreground="#C7F36B" FontSize="20"/><StackPanel Spacing="3"><TextBlock Text="{Binding ReservationDialogTitle}" Classes="section-title" FontSize="20"/><TextBlock Text="Заплануйте візит без нарахування вартості часу." Classes="muted" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Classes="window-control" Command="{Binding CancelNewReservationDialogCommand}" Content="×"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="500" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,16" Spacing="12">
                        <StackPanel Spacing="5"><TextBlock Text="Клієнт" FontSize="11"/><ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedReservationClient}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:ClientCard"><TextBlock Text="{Binding ChoiceText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <StackPanel Spacing="5"><TextBlock Text="Комп’ютер" FontSize="11"/><ComboBox ItemsSource="{Binding Computers}" SelectedItem="{Binding SelectedReservationComputer}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:ComputerCard"><TextBlock Text="{Binding ChoiceText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Дата" FontSize="11"/><DatePicker SelectedDate="{Binding NewReservationDate}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Час початку" FontSize="11"/><TextBox PlaceholderText="19:00" Text="{Binding NewReservationTime, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Тривалість" FontSize="11"/><ComboBox ItemsSource="{Binding DurationOptions}" SelectedItem="{Binding SelectedReservationDuration}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:DurationChoice"><TextBlock Text="{Binding DisplayText}" FontSize="11"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Час завершення" FontSize="11"/><TextBox Text="{Binding ReservationEndTimeText}" IsReadOnly="True"/></StackPanel></Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Примітка · необов’язково" FontSize="11"/><TextBox PlaceholderText="Підтверджено телефоном" Text="{Binding NewReservationNote, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <Border Background="#1C3953" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="ⓘ" Foreground="#72B8FF"/><TextBlock Text="{Binding ReservationAvailabilityText}" FontSize="10" Foreground="#A9D2FF" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="{Binding ReservationFormError}" Foreground="#FF8D8D" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#242B36" BorderThickness="0,1,0,0" Padding="20,12"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="LEOPARD · Київ / Поділ" Classes="muted" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Command="{Binding CancelNewReservationDialogCommand}" Content="Скасувати" Margin="0,0,8,0"/><Button Grid.Column="2" Classes="primary" Command="{Binding SaveNewReservationCommand}" IsEnabled="{Binding CanSaveReservation}" Content="{Binding ReservationDialogAction}"/></Grid></Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding IsAgentDialogOpen}" Background="#C9000000">
            <Border Classes="panel" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14" Padding="0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" BorderBrush="#242B36" BorderThickness="0,0,0,1" Padding="20,18,20,14"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="◉" Foreground="#C7F36B" FontSize="20"/><StackPanel Spacing="3"><TextBlock Text="Налаштування ПК-агента" Classes="section-title" FontSize="20"/><TextBlock Text="{Binding SelectedAgentComputer.ComputerLabel, StringFormat='{}{0} · параметри з’єднання з локальним сервером.'}" Classes="muted" FontSize="11"/></StackPanel></StackPanel><Button Grid.Column="1" Classes="window-control" Command="{Binding CancelAgentDialogCommand}" Content="×"/></Grid></Border>
                    <ScrollViewer Grid.Row="1" MaxHeight="500" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20,16" Spacing="12">
                        <Border Background="#342819" BorderBrush="#634A2D" BorderThickness="1" CornerRadius="8" Padding="11"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><TextBlock Text="Поточний стан" FontSize="11" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding AgentStatusText}" FontSize="10" Foreground="{Binding AgentStatusColor}"/><TextBlock Grid.Row="1" Text="{Binding AgentLastCheckText}" FontSize="10" Classes="muted" Margin="0,5,0,0"/></Grid></Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Ідентифікатор ПК" FontSize="11"/><TextBox Text="{Binding SelectedAgentComputer.ComputerLabel}" IsReadOnly="True"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Адреса ПК" FontSize="11"/><TextBox PlaceholderText="192.168.10.112" Text="{Binding EditAgentAddress, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Сервер клубу" FontSize="11"/><TextBox PlaceholderText="192.168.10.10" Text="{Binding EditAgentClubServer, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Порт" FontSize="11"/><TextBox PlaceholderText="47831" Text="{Binding EditAgentPort, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
                        <StackPanel Spacing="5"><TextBlock Text="Ключ підключення" FontSize="11"/><TextBox PasswordChar="●" PlaceholderText="Введіть спільний ключ агента" Text="{Binding EditAgentConnectionKey, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Інтервал повідомлень про стан" FontSize="10" Classes="muted" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><TextBox Width="70" Text="{Binding EditAgentPollSeconds, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="секунд" FontSize="10" Classes="muted" VerticalAlignment="Center"/></StackPanel></Grid>
                        <Border Background="#10151C" CornerRadius="8" Padding="10"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="ⓘ" Classes="muted"/><TextBlock Text="Збереження параметрів не означає з’єднання. Статус зміниться після фактичного підключення агента." FontSize="10" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                        <TextBlock Text="{Binding ComputerFormError}" Foreground="#FF8D8D" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#242B36" BorderThickness="0,1,0,0" Padding="20,12"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="LEOPARD · Київ / Поділ" Classes="muted" FontSize="9" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="secondary" Command="{Binding CancelAgentDialogCommand}" Content="Скасувати" Margin="0,0,8,0"/><Button Grid.Column="2" Classes="primary" Command="{Binding SaveComputerAgentEndpointCommand}" Content="Зберегти"/></Grid></Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
